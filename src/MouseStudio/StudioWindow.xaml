<Window x:Class="MouseLab5.StudioWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mouse Studio" Width="1180" Height="820" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#F5F7FB" FontFamily="Malgun Gothic" FontSize="14" Foreground="#202B40" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#5267EB"/>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="18,10"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#34415A"/><Setter Property="BorderBrush" Value="#E3E8F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.55"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="44"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#E2E7EF"/><Setter Property="Background" Value="#FAFBFD"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="44"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="White" BorderBrush="#E0E6F0" BorderThickness="1" CornerRadius="9"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#8893AA"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,6,34,6" VerticalAlignment="Center"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Background="White" BorderBrush="#E1E6F0" BorderThickness="1" CornerRadius="9" Padding="4"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="7,0,0,0"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E7EBF3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="24"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#748098"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" Background="#F8FAFD" BorderBrush="#E8ECF4" BorderThickness="1" CornerRadius="10" Padding="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#EEF1FF"/><Setter TargetName="B" Property="BorderBrush" Value="#8797F4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E8ECF3" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragHeader">
   <Grid Margin="28,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#5267EB" CornerRadius="11" Width="38" Height="38"><TextBlock Text="↗" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Mouse Studio" Margin="13,0,0,0" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#F0F4F9" CornerRadius="9" Padding="13,7" Margin="0,0,18,0"><TextBlock x:Name="Status" Text="대기 중" Foreground="#5C6A80" FontSize="12"/></Border><Button Content="−" Style="{StaticResource Quiet}" Width="42" Padding="0" Click="Minimize"/><Button Content="?" Style="{StaticResource Quiet}" Width="42" Padding="0" Click="Help"/><Button Content="×" Style="{StaticResource Quiet}" Width="42" Padding="0" Click="Exit"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#E8ECF3" BorderThickness="0,0,1,0"><Grid Margin="18,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="WORKSPACE" Foreground="#97A0B1" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,18"/><Button x:Name="MouseNav" Grid.Row="1" Content="↗   마우스 설정" HorizontalContentAlignment="Left" Background="#EEF1FF" Foreground="#5267EB" BorderThickness="0" Click="MouseTab"/><Button x:Name="MacroNav" Grid.Row="2" Content="≡   매크로" VerticalAlignment="Top" Margin="0,10,0,0" Style="{StaticResource Quiet}" Click="MacroTab"/><Button Grid.Row="3" Content="■   실행 중단" Foreground="#DC5868" Background="#FFF3F4" BorderThickness="0" Click="StopEverything"/></Grid></Border>
   <Grid Grid.Column="1" Margin="30,26,30,24">
    <ScrollViewer x:Name="MousePage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="마우스 설정" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="1~5번 모두 직접 조작 · 번호별 위치 기억" Foreground="#8993A6" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="▶  일괄 실행" Style="{StaticResource Primary}" Click="RunAll" VerticalAlignment="Center"/></Grid>
     <Border Style="{StaticResource Card}" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="포인터 표시" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal"><Button x:Name="ColorMode" Content="색상" Padding="18,10" Margin="0,0,7,0" Click="SetColor"/><Button x:Name="NumberMode" Content="숫자" Padding="18,10" Margin="0,0,7,0" Click="SetNumber"/><Button x:Name="NoMode" Content="기본형" Padding="16,10" Click="SetNone"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock Text="수동 전환" Style="{StaticResource Caption}"/><TextBlock Text="Alt + 1 · 2 · 3 · 4 · 5" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Grid></Border>
     <UniformGrid x:Name="MouseCards" Columns="2"/>
    </StackPanel></ScrollViewer>
    <Grid x:Name="MacroPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="매크로" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PresetState" Text="새 프리셋" Foreground="#8993A6" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RecordButton" Content="● 녹화 F9" Margin="0,0,8,0" Click="RecordToggle"/><Button Content="불러오기" Margin="0,0,8,0" Click="LoadProfile"/><Button Content="저장" Style="{StaticResource Primary}" Click="SaveProfile"/></StackPanel></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.98*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.02*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBox x:Name="ProfileName" Text="새 프리셋" FontSize="17" FontWeight="SemiBold" ToolTip="이름을 수정하고 저장하면 프리셋 이름이 변경됩니다"/><WrapPanel Margin="0,10,0,0"><Button Content="새로 만들기" Click="NewProfile" MinHeight="34" Padding="12,6" Margin="0,0,6,0"/><Button Content="복제" Click="DuplicateProfile" MinHeight="34" Padding="12,6" Margin="0,0,6,0"/><Button Content="프리셋 삭제" Click="DeleteProfile" Foreground="#D85B6C" MinHeight="34" Padding="12,6"/></WrapPanel></StackPanel><StackPanel Grid.Row="1" Margin="0,0,0,12"><ComboBox x:Name="AddType" Visibility="Collapsed" SelectedIndex="0"><ComboBoxItem Content="클릭"/><ComboBoxItem Content="더블 클릭"/><ComboBoxItem Content="우클릭"/><ComboBoxItem Content="가운데 클릭"/><ComboBoxItem Content="이동"/><ComboBoxItem Content="드래그"/><ComboBoxItem Content="누르기"/><ComboBoxItem Content="스크롤"/><ComboBoxItem Content="딜레이"/></ComboBox><WrapPanel><Button Content="클릭" Tag="클릭" MinHeight="34" FontSize="12" Padding="10,7" Margin="0,0,6,6" Click="AddStep"/><Button Content="더블 클릭" Tag="더블 클릭" MinHeight="34" FontSize="12" Padding="10,7" Margin="0,0,6,6" Click="AddStep"/><Button Content="우클릭" Tag="우클릭" MinHeight="34" FontSize="12" Padding="10,7" Margin="0,0,6,6" Click="AddStep"/><Button Content="가운데 클릭" Tag="가운데 클릭" MinHeight="34" FontSize="12" Padding="10,7" Margin="0,0,6,6" Click="AddStep"/><Button Content="이동" Tag="이동" MinHeight="34" FontSize="12" Padding="10,7" Margin="0,0,6,6" Click="AddStep"/><Button Content="드래그" Tag="드래그" MinHeight="34" FontSize="12" Padding="10,7" Margin="0,0,6,6" Click="AddStep"/><Button Content="누르기" Tag="누르기" MinHeight="34" FontSize="12" Padding="10,7" Margin="0,0,6,6" Click="AddStep"/><Button Content="스크롤" Tag="스크롤" MinHeight="34" FontSize="12" Padding="10,7" Margin="0,0,6,6" Click="AddStep"/><Button Content="딜레이" Tag="딜레이" MinHeight="34" FontSize="12" Padding="10,7" Margin="0,0,6,6" Click="AddStep"/></WrapPanel></StackPanel><ListBox x:Name="StepList" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionChanged="SelectStep" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Grid Grid.Row="3" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="실행 전 딜레이 (ms)" Style="{StaticResource Caption}"/><TextBox x:Name="DelayBefore" Text="0" LostFocus="CommitEditor"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="실행 후 딜레이 (ms)" Style="{StaticResource Caption}"/><TextBox x:Name="DelayAfter" Text="100" LostFocus="CommitEditor"/></StackPanel></Grid><Grid Grid.Row="4" Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="↑" Click="UpStep" Padding="0"/><Button Grid.Column="1" Content="↓" Click="DownStep" Margin="6,0" Padding="0"/><Button Grid.Column="2" Content="복제" Click="DuplicateStep" Padding="6"/><Button Grid.Column="3" Content="삭제" Click="DeleteStep" Margin="6,0,0,0" Padding="6"/></Grid></Grid></Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto">
       <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel x:Name="StepEditor"><TextBlock Text="동작 설정" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/><ComboBox x:Name="EditKind" Margin="0,0,0,14" SelectionChanged="ChangeKind"><ComboBoxItem Content="클릭"/><ComboBoxItem Content="더블 클릭"/><ComboBoxItem Content="우클릭"/><ComboBoxItem Content="가운데 클릭"/><ComboBoxItem Content="이동"/><ComboBoxItem Content="드래그"/><ComboBoxItem Content="누르기"/><ComboBoxItem Content="스크롤"/><ComboBoxItem Content="딜레이"/></ComboBox>
        <StackPanel x:Name="ButtonFields" Margin="0,0,0,14"><TextBlock Text="마우스 버튼" Style="{StaticResource Caption}"/><ComboBox x:Name="ButtonChoice" SelectedIndex="0" SelectionChanged="ChangeButton"><ComboBoxItem Content="왼쪽"/><ComboBoxItem Content="오른쪽"/><ComboBoxItem Content="가운데"/></ComboBox></StackPanel>
        <Grid x:Name="PositionFields"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="X 좌표" Style="{StaticResource Caption}"/><TextBox x:Name="EditX" Text="100" LostFocus="CommitEditor"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Y 좌표" Style="{StaticResource Caption}"/><TextBox x:Name="EditY" Text="100" LostFocus="CommitEditor"/></StackPanel></Grid>
        <Grid x:Name="EndFields" Margin="0,14,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="도착 X" Style="{StaticResource Caption}"/><TextBox x:Name="EditEndX" Text="200" LostFocus="CommitEditor"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="도착 Y" Style="{StaticResource Caption}"/><TextBox x:Name="EditEndY" Text="200" LostFocus="CommitEditor"/></StackPanel></Grid>
        <StackPanel x:Name="ValueFields"><TextBlock x:Name="ValueLabel" Text="동작 후 대기 (ms)" Style="{StaticResource Caption}" Margin="0,18,0,8"/><TextBox x:Name="EditValue" Text="0" LostFocus="CommitEditor"/></StackPanel><Button Content="선택한 마우스 위치 사용" Margin="0,16,0,0" Click="UsePosition"/></StackPanel></Border>
      </ScrollViewer><Border Grid.Row="1" Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="프리셋 설정" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><ComboBox x:Name="PositionBasis" SelectedIndex="1" Margin="0,0,0,12" ToolTip="저장한 좌표 그대로 실행하거나, 동작 경로를 각 마우스 위치로 옮겨 실행합니다"><ComboBoxItem Content="저장한 위치 기준"/><ComboBoxItem Content="각 마우스 위치 기준"/></ComboBox><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="적용할 마우스" Style="{StaticResource Caption}"/><ComboBox x:Name="TargetSlot" SelectedIndex="0" SelectionChanged="MouseTargetChanged"><ComboBoxItem Content="마우스 1"/><ComboBoxItem Content="마우스 2"/><ComboBoxItem Content="마우스 3"/><ComboBoxItem Content="마우스 4"/><ComboBoxItem Content="마우스 5"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="반복 횟수" Style="{StaticResource Caption}"/><StackPanel><TextBox x:Name="RepeatCount" Text="3" HorizontalContentAlignment="Center"/><CheckBox x:Name="Infinite" Content="무한 반복" Margin="0,6,0,0" Cursor="Hand" Checked="RepeatChanged" Unchecked="RepeatChanged"/></StackPanel></StackPanel></Grid><Button Content="▶  저장 후 적용 · 실행" Style="{StaticResource Primary}" Click="RunMacro"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="일시 정지 / 재개" Padding="6,8" Click="PauseMacro"/><Button Grid.Column="1" Content="실행 종료" Padding="6,8" Margin="8,0,0,0" Click="StopMacro"/></Grid><ProgressBar x:Name="Progress" Height="5" Margin="0,12,0,0" Background="#EDF0F8" Foreground="#5267EB" BorderThickness="0"/></StackPanel></Border></Grid>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="HelpLayer" Grid.Row="1" Visibility="Collapsed" Background="#FCFDFE" Padding="28"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#F0F3FC" CornerRadius="18" Margin="0,0,26,0" Padding="24"><StackPanel><TextBlock Text="빠른 사용 가이드" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,22"/><Border BorderBrush="#5267EB" BorderThickness="2" CornerRadius="12" Padding="20" Margin="0,0,0,16"><TextBlock Text="①  1~5 수동 전환" FontSize="18"/></Border><Border BorderBrush="#5267EB" BorderThickness="2" CornerRadius="12" Padding="20" Margin="0,0,0,16"><TextBlock Text="②  동작 순서 만들기" FontSize="18"/></Border><Border BorderBrush="#5267EB" BorderThickness="2" CornerRadius="12" Padding="20" Margin="0,0,0,16"><TextBlock Text="③  반복과 실행" FontSize="18"/></Border><Border BorderBrush="#5267EB" BorderThickness="2" CornerRadius="12" Padding="20"><TextBlock Text="④  포인터 표시" FontSize="18"/></Border></StackPanel></Border><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HelpText"/></ScrollViewer></Grid></Border>
 </Grid>
</Window>
